# Copia este archivo a .env y ajusta los valores
STORAGE_DIR=/data/jobs
REDIS_URL=redis://redis:6379/0
MAX_UPLOAD_MB=50
MAX_PAGES=200
JOB_TTL_MINUTES=60
ALLOWED_ORIGINS=https://tu-sitio.vercel.app
API_KEY=cambia-esta-clave-larga
RATE_LIMIT_PER_HOUR=60
OCR_LANG=spa+eng
DOWNLOAD_SECRET=<redacted>
# Secreto para firmar los tokens de subida directa (cualquier valor largo y aleatorio;
# distinto de API_KEY y de DOWNLOAD_SECRET). Sin él, la subida directa devuelve 503.
UPLOAD_SECRET=cambia-este-secreto-largo
# Validez del token de subida, en segundos (5 minutos por defecto).
UPLOAD_TOKEN_TTL_SECONDS=300
TASK_TIME_LIMIT=600
# Tope de cola: trabajos en queued/processing a partir del cual la API
# responde 503 "Estamos con mucha demanda, intenta en unos minutos".
MAX_QUEUE_JOBS=50
# Máximo de páginas con OCR por trabajo (el OCR es el paso más caro).
MAX_OCR_PAGES=20
